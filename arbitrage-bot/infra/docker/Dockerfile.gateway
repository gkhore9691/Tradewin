# Multi-stage build for Gateway Node
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY apps/gateway-node/package*.json ./
COPY packages/schemas/package*.json ./packages/schemas/
COPY packages/utils/package*.json ./packages/utils/

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY apps/gateway-node/src ./src
COPY packages/schemas ./packages/schemas
COPY packages/utils ./packages/utils

# Build the application
RUN npm run build

# Production stage
FROM node:18-alpine AS production

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S gateway -u 1001

WORKDIR /app

# Copy built application
COPY --from=builder --chown=gateway:nodejs /app/dist ./dist
COPY --from=builder --chown=gateway:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=gateway:nodejs /app/packages ./packages

# Copy configuration
COPY apps/gateway-node/env.example ./.env

# Switch to non-root user
USER gateway

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/healthz', (res) => process.exit(res.statusCode === 200 ? 0 : 1))"

# Start the application
CMD ["node", "dist/index.js"]

